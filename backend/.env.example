NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/showpro?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=storage/uploads
PRIVATE_FILE_TTL_MINUTES=30
AUTOMATION_POLL_SECONDS=60
PDF_FONT_PATH=
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_TOKEN=
# Max auth attempts (login / forgot-password / register) per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
# Local development only: return the reset token in the forgot-password response. Refused in production.
EXPOSE_RESET_TOKEN=false
